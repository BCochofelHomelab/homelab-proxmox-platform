          <mxGeometry x="120" y="50" width="160" height="46" as="geometry" />
        </mxCell>

        <mxCell id="core" value="homelab-proxmox-core &#183; the edge (VMs on pve1)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=right;spacingRight=12;spacingTop=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=15;fontStyle=1;arcSize=4;" vertex="1" parent="1">
