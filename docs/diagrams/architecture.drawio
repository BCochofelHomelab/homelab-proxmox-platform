          <mxGeometry x="360" y="152" width="150" height="104" as="geometry" />
        </mxCell>
        <mxCell id="runner01" value="&lt;b&gt;runner01&lt;/b&gt; &#183; .9&lt;br&gt;dry-run CI runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="526" y="152" width="140" height="104" as="geometry" />
        </mxCell>

        <!-- The operator's tooling -->
        <mxCell id="operator" value="You (your clone) &#183; mise run tofu:* / ansible:site" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=15;fontStyle=1;arcSize=4;" vertex="1" parent="1">
