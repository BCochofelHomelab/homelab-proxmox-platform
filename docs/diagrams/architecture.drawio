<mxfile host="app.diagrams.net" agent="homelab-proxmox-platform" version="24.0.0" type="device">
  <diagram name="Architecture" id="homelab-platform-architecture">
    <mxGraphModel dx="1400" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="homelab-proxmox-platform &#8212; architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="400" y="5" width="600" height="30" as="geometry" />
