        </mxCell>
        <mxCell id="tofu" value="&lt;b&gt;OpenTofu + Terramate&lt;/b&gt;&lt;br&gt;one state per stack&lt;br&gt;(HCP Terraform, Local execution)&lt;br&gt;&lt;br&gt;VM stacks &#8594; Proxmox API&lt;br&gt;shared/, agent-policies/, workspaces/&lt;br&gt;&#8594; Elasticsearch and Kibana APIs" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="88" width="300" height="168" as="geometry" />
        </mxCell>
        <mxCell id="ansible" value="&lt;b&gt;Ansible&lt;/b&gt;&lt;br&gt;inventory: Proxmox's own list of VMs,&lt;br&gt;by tag (read-only token, via Caddy)&lt;br&gt;&lt;br&gt;SSH to the platform VMs&lt;br&gt;internal CA: signs each host's CSR;&lt;br&gt;keys never leave the hosts" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=13;arcSize=8;" vertex="1" parent="1">
